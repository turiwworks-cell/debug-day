{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "debug-day",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "debug-day-data",
    "database_id": "633cfa06-e22e-4d86-85b0-211310a946ba"
  }],
  "observability": {"enabled": false}
}
